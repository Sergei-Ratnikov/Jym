<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Фоновая картинка -->
    <ImageView
        android:id="@+id/image_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/coat_of_arms"
        android:scaleType="centerInside"
        android:alpha="0.05"
        android:contentDescription="@null" />

    <!-- Контент -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp"
        android:gravity="center">

        <!-- Заголовок -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Jym"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Основной текст -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:textSize="17sp"
            android:text="Привет!\nЭто трекер тренировок, который работает без интернета и регистрации. Создавай упражнения, собирай из них тренировки и веди историю — всё хранится только на твоём телефоне.\n\nНачни с раздела «Упражнения» — там уже есть начальный набор. Затем собери тренировки по себе и приступай!\n\nСоблюдает дня режим Jym!" />

        <!-- Распорщик, прижимающий галочку и кнопку вниз -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Галочка -->
        <CheckBox
            android:id="@+id/check_dont_show"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Больше не показывать"
            android:textSize="13sp" />

        <!-- Кнопка «Начать» -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Начать!"
            android:textSize="16sp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            app:backgroundTint="@color/primary_green" />

    </LinearLayout>

</FrameLayout>